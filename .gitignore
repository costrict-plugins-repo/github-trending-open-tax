# User workspace (contains sensitive tax documents)
workspace/raw/
workspace/parsed/
workspace/computed/
workspace/output/

# Keep the workspace directory structure
!workspace/.gitkeep

# Tax documents in workspace
workspace/**/*.pdf
workspace/**/*.PDF
workspace/**/*.jpg
workspace/**/*.jpeg
workspace/**/*.png

# Environment
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets / credentials
credentials.*
*.key
*.pem
